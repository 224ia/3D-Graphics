#version 330 core

uniform vec2 iResolution;
uniform float iTime;
uniform vec3 pos;
uniform float uYaw;
uniform float uPitch;
uniform float uScroll;

out vec4 color;

vec3 camera = vec3(0, 0, 0);

struct Sphere {
    vec3 center;
    float r;
    vec3 color;
};
struct Box {
    vec3 center;
    vec3 size;
    vec3 color;
};
struct Plane {
    float height;
    vec3 color;
};

Sphere spheres[2];
Box boxes[2];
Plane planes[1];

vec3 light = normalize(vec3(0.45, -1, 1));

vec3 skyColor = vec3(0.4, 0.45, 0.71);

float distToSphere(in vec3 origin, in vec3 center, in float radius) {
    return length(center - origin) - radius;
}

float distToBox(in vec3 origin, in vec3 center, in vec3 size) {
    vec3 q = abs(origin - center) - size;
    return length(max(q, 0.0)) + min(max(q.x, max(q.y, q.z)), 0.0);
}

float distToPlane(in vec3 origin, in float height) {
    return (origin.y - height);
}

float sdTorus( vec3 p, vec2 t )
{
  vec2 q = vec2(length(p.xz)-t.x,p.y);
  return length(q)-t.y;
}

float closest(in vec3 origin, out vec3 col) {
    float tMin = distToPlane(origin, planes[0].height);
    col = planes[0].color;
    float t;
    for(int i = 0; i < spheres.length(); i++) {
        t = distToSphere(origin, spheres[i].center, spheres[i].r);
        if (t < tMin) {
            tMin = t;
            col = spheres[i].color;
        }
    }
    for(int i = 0; i < boxes.length(); i++) {
        t = distToBox(origin, boxes[i].center, boxes[i].size);
        if (t < tMin) {
            tMin = t;
            col = boxes[i].color;
        }
    }
    for(int i = 1; i < planes.length(); i++) {
        t = distToPlane(origin, planes[i].height);
        if (t < tMin) {
            tMin = t;
            col = planes[i].color;
        }
    }
    t = sdTorus(origin - vec3(4, 2, 9), vec2(10, 0.1));
    if (t < tMin) {
        tMin = t;
        col = vec3(0.68, 0.0, 1.0);
    }
    
    return tMin;
}

vec3 getNormal(vec3 p)
{
    vec3 col; // no need but I create to put in parameters
    float d = closest(p, col);
    vec2 e = vec2(0.001, 0);
    vec3 n = d - vec3(closest(p - e.xyy, col), closest(p - e.yxy, col), closest(p - e.yyx, col));
    return normalize(n);
}

vec4 march(in vec3 dir, inout vec3 origin) {
    for(int i = 0; i < 1000; i++) {
        vec3 col;
        float step = closest(origin, col);
        if (step > 500) break;
        origin += dir * step;
        if (step <= 0.01) {
            return vec4(col, 1.0);
        }
    }
    vec3 sun = vec3(1) * pow(max(dot(dir, -light), 0.0),32.0) * 20;
    vec3 col = vec3(skyColor + sun / 11.5);
    return vec4(col, 0.0);
}

float getLight(in vec3 hit) {
    vec3 normal = getNormal(hit);
    float brightness = max(0.0, dot(-light, normal));
    vec3 origin = hit + normal * 0.025;
    if (march(-light, origin).a != 0.0) brightness *= 0.3;
    return brightness;
}

vec3 rotate(vec3 dir, float angle, bool xz) {
    float sin = sin(angle);
    float cos = cos(angle);

    return xz ? vec3(dir.x * cos - dir.z * sin,  dir.y, dir.x * sin + dir.z * cos) :
                vec3(dir.x, dir.y * cos - dir.z * sin, dir.y * sin + dir.z * cos);
}

void main() {
    vec2 uv = gl_FragCoord.xy / iResolution.xy - 0.5;
    float aspect = iResolution.x / iResolution.y;
    uv.x *= aspect;

    light = normalize(vec3(0.45, -(sin(iTime / 5)), -cos(iTime / 5)));

    spheres[0] = Sphere(vec3(1.0, -4.5, -15.0), 2.0,
                        vec3(0.9, 0.91, 0.33));
    spheres[1] = Sphere(vec3(2.0, -5, -12.0), 3.0,
                        vec3(1.0, 0.27, 0.27));
    
    boxes[0] = Box(vec3(-2.0, -4.0, -15.0),
                    vec3(1.0, 2.0, 3.0),
                    vec3(0.12, 1.0, 0.51));
    
    boxes[1] = Box(vec3(4.0, -2.5, -5.0),
                    vec3(1.0, 5.0, 1.0),
                    vec3(0.5, 0.8, (sin(iTime) * 0.5 + 0.5)));

    planes[0] = Plane(-5.0, vec3(0.21, 0.45, 0.91));

    camera = pos;

    vec3 startDir = normalize(vec3(uv.xy, -uScroll));
    vec3 dir = rotate(startDir, uPitch, false);
    dir = rotate(dir, uYaw, true);
    
    vec3 origin = camera;
    vec4 col = march(dir, origin);
    if (col.a == 1.0) {
        col.rgb *= getLight(origin);
    }
    color = vec4(col.rgb, 1.0);
}